# ── Telegram API credentials (my.telegram.org → API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ── Panel bot token from @BotFather (the bot sends the inline control panel)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=YourPanelBot

# ── Your numeric Telegram ID (from @userinfobot) — only this ID can use the panel
ADMIN_ID=123456789

# ── optional: state file path (default state.json)
# STATE_FILE=state.json
