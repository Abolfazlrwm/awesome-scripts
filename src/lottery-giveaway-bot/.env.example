# توکن ربات را از @BotFather دریافت کنید
BOT_TOKEN=123456789:your-telegram-bot-token

# آیدی عددی خودتان را از @userinfobot بگیرید
ADMIN_ID=123456789

# یوزرنیم شما که در متن پشتیبانی نمایش داده می‌شود (بدون @)
OWNER_USERNAME=YourUsername

# نامی که در متن‌های ربات (پنل مدیریت، معرفی) نمایش داده می‌شود
BOT_DISPLAY_NAME=ربات قرعه‌کشی
