EMOJI_FORGE_TOKEN=
EMOJI_FORGE_ADMIN_IDS=
EMOJI_FORGE_DATA_DIR=
EMOJI_FORGE_MAX_CONCURRENT=2
EMOJI_FORGE_MAX_FILE_BYTES=20971520
# Brain provider: rule (default, no model, no cost) | muse-bridge (async file queue, see BRAIN.md) | external (optional only)
EMOJI_FORGE_BRAIN_PROVIDER=rule
# Only for provider=external, and only if you explicitly choose it. Never commit this file.
EMOJI_FORGE_EXTERNAL_BRAIN_URL=
EMOJI_FORGE_EXTERNAL_BRAIN_KEY=
# --- Custom AI provider (v10.1, optional, owner config only) -------------
# Any OpenAI-compatible endpoint. Setting AI_API_KEY activates this
# provider with priority over EMOJI_FORGE_BRAIN_PROVIDER. On any error
# the bot falls back to the built-in rule suggestions automatically.
# Examples: OpenAI -> AI_BASE_URL=https://api.openai.com/v1
#           OpenRouter -> AI_BASE_URL=https://openrouter.ai/api/v1
#           Local server -> AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# --- cPanel web panel (optional) ------------------------------------------
# Password key for cpanel/panel.php. Set a long random value; the panel
# never displays secret values, it only checks this key for login.
PANEL_KEY=

# Distributable build: the bot owner id is read from EMOJI_FORGE_OWNER_ID
# (or, if empty, the first EMOJI_FORGE_ADMIN_IDS entry).
EMOJI_FORGE_OWNER_ID=
